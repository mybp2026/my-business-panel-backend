### ==============================================================
### 0. VERIFICACIÓN PREVIA - Obtener condiciones de venta disponibles
### ==============================================================
### Verifica qué condiciones de venta están disponibles en el sistema

GET {{baseUrl}}/sale
Authorization: Bearer {{tenantToken}}

### ==============================================================
### 1. CREAR VENTA COMPLETA CON MÚLTIPLES PRODUCTOS
### ==============================================================
### Crea una venta con:
### - 1 Laptop Dell XPS 13 @ 1,500,000 CRC
### - 2 Teclados Mecánicos @ 150,000 CRC c/u
### - 1 Mouse inalámbrico @ 50,000 CRC

@saleId = e9587040-99df-4689-a900-3465c85d778b
# @name createSale
POST {{baseUrl}}/sale
Content-Type: application/json
Authorization: Bearer {{tenantToken}}

{
  "tenant_id": "{{tenantId}}",
  "branch_id": "{{branchId}}",
  "currency_id": {{currencyId}},
  "tenant_customer_id": "{{customerId}}",
  "sale_condition": "{{saleCondition}}",
  "sale_date": "{{saleDate}}",
  "subtotal_amount": 1850000,
  "tax_amount": 240500,
  "total_amount": 2090500,
  "is_completed": true,
  "has_electronic_invoice": false,
  "items": [
    {
      "tenant_id": "{{tenantId}}",
      "product_variant_id": "{{productVariantId1}}",
      "quantity": 1,
      "unit_price": 1500000,
      "total_price": 1500000,
      "sale_price_type": "NORMAL",
      "discount_applied": 0
    },
    {
      "tenant_id": "{{tenantId}}",
      "product_variant_id": "{{productVariantId2}}",
      "quantity": 2,
      "unit_price": 150000,
      "total_price": 300000,
      "sale_price_type": "NORMAL",
      "discount_applied": 0
    },
    {
      "tenant_id": "{{tenantId}}",
      "product_variant_id": "{{productVariantId3}}",
      "quantity": 1,
      "unit_price": 50000,
      "total_price": 50000,
      "sale_price_type": "NORMAL",
      "discount_applied": 0
    }
  ],
  "payments": [
    {
      "tenant_customer_id": "{{customerId}}",
      "payment_method_id": {{paymentMethodId}},
      "is_points_redemption": false,
      "points_redeemed": 0,
      "points_to_currency_rate": 0,
      "payment_amount": 2090500,
      "payment_date": "{{paymentDate}}",
      "currency_id": {{currencyId}},
      "verified": true
    }
  ]
}

### ==============================================================
### 2. VERIFICAR VENTA CREADA
### ==============================================================
### Obtiene los detalles de la venta creada

GET {{baseUrl}}/sale/{{branchId}}
Authorization: Bearer {{tenantToken}}

### ==============================================================
### 3. VERIFICAR FACTURA DIGITAL CREADA
### ==============================================================
### La factura digital se crea automáticamente al crear la venta
### Este endpoint obtiene los detalles de la factura digital

GET {{baseUrl}}/invoice/details/{{saleId}}
Authorization: Bearer {{tenantToken}}


### 4. CREAR FACTURA ELECTRÓNICA Y ENVIAR A HACIENDA
  ### 1. Genera XML firmado digitalmente
  ### 2. Lo envía a Hacienda
  ### 3. Genera clave y código QR
  ### 4. Realiza un quick-poll a los 3 segundos
  ### 5. Si está pendiente, usa backoff exponencial para reintentosActualizando con el saleId generado anteriormente
POST {{baseUrl}}/sale/{{saleId}}/e-invoice
Content-Type: application/json


### 5. OBTENER FACTURA ELECTRÓNICA CREADA
# @name getEInvoice
GET {{baseUrl}}/sale/{{saleId}}/e-invoice
Authorization: bearer {{tenantToken}}

@eInvoiceId = {{getEInvoice.response.body[0].electronic_sale_invoice_id}}
@eInvoiceKey = {{getEInvoice.response.body[0].key_number}}

### ==============================================================
### 6. OBTENER TODAS LAS FACTURAS ELECTRÓNICAS DE LA RAMA
### ==============================================================
### Lista todas las facturas electrónicas generadas en esta rama

GET {{baseUrl}}/sale/e-invoice/branch/{{branchId}}
Authorization: Bearer {{tenantToken}}

### ==============================================================
### 7. VERIFICAR ESTADO DE LA FACTURA EN HACIENDA
### ==============================================================
### Obtiene los detalles actualizados de la factura electrónica
### Incluye el estado de procesamiento en Hacienda:
### - Estado 1: Pendiente
### - Estado 2: Aceptada
### - Estado 3: Rechazada
### - Estado 4: Timeout

GET {{baseUrl}}/sale/e-invoice/{{eInvoiceId}}
Authorization: Bearer {{tenantToken}}

