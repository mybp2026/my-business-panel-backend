@economicActivity = 6311
@signName = AMH_SOLUTIONS

### ==============================================================
### 0. PRE-REQUISITOS / ACCESO SISTEMA
### ==============================================================

### LOGIN DE SISTEMA (ADMINISTRADOR GLOBAL)
# @name systemLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "david@amh.com",
  "password": "SecurePassword123!"
}

# @systemToken = {{systemLogin.response.body.token}}

# POST {{baseUrl}}/user
# Content-Type: application/json
# Authorization: Bearer {{systemToken}}

# {
