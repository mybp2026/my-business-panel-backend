### ==============================================================
### 1. CREAR TENANT
### ==============================================================
# @name createTenant
POST {{baseUrl}}/tenant
Content-Type: application/json

{
  "tenant_name": "{{tenantName}}",
  "contact_email": "{{contactEmail}}",
  "region_id": "{{regionId}}",
  "identification": "{{tenantIdentification}}",
  "economic_activity": "{{economicActivity}}",
  "sign": "{{signName}}"
}

# @tenantId = {{createTenant.response.body.tenant_id}}

### ==============================================================
### 2. CREAR RAMA PRINCIPAL (BRANCH)
### ==============================================================
# @name createBranch
POST {{baseUrl}}/branch
Content-Type: application/json

{
  "tenant_id": "{{tenantId}}",
  "branch_name": "Oficina Principal",
  "branch_number": "001",
  "branch_address": "Calle Principal 123, San José, Costa Rica",
  "contact_email": "{{contactEmail}}",
  "is_main_branch": true
}

@branchId = 859cc745-185e-4af3-82fc-9c5b8d6e6f26 

### ==============================================================
### 3. CREAR USUARIO ADMINISTRADOR DEL TENANT
### ==============================================================
POST {{baseUrl}}/user
Content-Type: application/json

{
  "tenant_id": "{{tenantId}}",
  "email": "{{contactEmail}}",
  "password": "AdminPassword123!",
  "role_id": 2, 
  "employeeInfo": {
    "tenant_id": "{{tenantId}}",
    "branch_id": "{{branchId}}",
    "first_name": "Juan",
    "last_name": "Administrador",
    "doc_number": "1001234567",
    "phone": "88776655",
    "email": "{{contactEmail}}",
    "payment_schedule_id": 1,
    "contractData": {
      "start_date": "2026-01-01",
      "end_date": "2027-12-31",      
      "hours": 8,
      "base_salary": 1500000,
      "duties": "Administración del Tenant",
      "turn_type": 1,
      "turn_id": 1
    }
  }
}


### ==============================================================
### 4. LOGIN DEL TENANT (SESIÓN DE ADMINISTRADOR)
